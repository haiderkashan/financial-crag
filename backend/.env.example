# Backend Configuration
PROJECT_NAME="Financial SEC Due-Diligence CRAG API"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
MAGIC_LINK_EXPIRE_MINUTES=15

# Supabase (Database & Vector Store)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SMTP Transactional Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="analyst-auth@financialcrag.local"
SMTP_USE_TLS=true
SMTP_DEV_MODE=true

# Client URL & CORS
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# SEC EDGAR Sourcing
SEC_EDGAR_USER_AGENT="FinancialCRAG admin@example.com"
SEC_EDGAR_BASE_URL="https://data.sec.gov"
SEC_EDGAR_RATE_LIMIT_RPS=8
DATA_DIR="data/filings"

# LlamaParse Configuration
LLAMA_CLOUD_API_KEY="llx-your-api-key"
LLAMA_PARSE_RESULT_TYPE="markdown"
LLAMA_PARSE_NUM_WORKERS=4

# Embedding Model (BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE=32

# LLM Provider Configuration
LLM_PROVIDER="groq"
LLM_MODEL_NAME="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.0
GROQ_API_KEY="gsk_your-groq-api-key"
OPENAI_API_KEY="sk-your-openai-api-key"
GOOGLE_API_KEY="your-google-api-key"

# Tavily Web Search Configuration
TAVILY_API_KEY="tvly-your-tavily-api-key"
TAVILY_MAX_RESULTS=4
TAVILY_SEARCH_DEPTH="advanced"

# CRAG Retrieval & Agent Configuration
CRAG_RETRIEVAL_TOP_K=10
CRAG_SIMILARITY_THRESHOLD=0.5
CRAG_MAX_REPL_TIMEOUT_SECONDS=10
