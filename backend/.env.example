# Backend Configuration
PROJECT_NAME="Financial SEC Due-Diligence CRAG API"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
MAGIC_LINK_EXPIRE_MINUTES=15

# Supabase (Database & Vector Store)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SMTP Transactional Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="analyst-auth@financialcrag.local"
SMTP_USE_TLS=true
SMTP_DEV_MODE=true

# Client URL & CORS
FRONTEND_URL="http://localhost:3000"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# SEC EDGAR Sourcing
SEC_EDGAR_USER_AGENT="FinancialCRAG admin@example.com"
SEC_EDGAR_BASE_URL="https://data.sec.gov"
SEC_EDGAR_RATE_LIMIT_RPS=8
DATA_DIR="data/filings"

